# Copy to .env and fill in. Also create secrets/postgres_password.txt and
# secrets/gmail_service_account.json (see docker-compose.yaml secrets block).

# ── Warehouse Postgres ────────────────────────────────────────────────────────
POSTGRES_USER=warehouse_admin
POSTGRES_DB=warehouse
POSTGRES_PORT=5432
DAGSTER_POSTGRES_PASSWORD=changeme   # must match secrets/postgres_password.txt

# Active warehouse schema: dev | test | prod (see docs/operations.md)
WAREHOUSE_SCHEMA=dev

# ── UIs ───────────────────────────────────────────────────────────────────────
DAGSTER_PORT=3000
DAGSTER_UI_URL=http://localhost:3000
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.org
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Source: IBM DB2 / Keystone core (on-prem network only) ───────────────────
SOURCE_DB_HOST=
SOURCE_DB_PORT=50000
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
# Optional manual-run override: D0001LIV (default) | D0001T31 | D0001T32 | D0001T33
KEYSTONE_DB_OVERRIDE=

# ── Source: JasperServer reporting API ───────────────────────────────────────
JASPER_SERVER_URL=
JASPER_USERNAME=
JASPER_PASSWORD=

# ── Source: HubSpot CRM API ──────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=

# ── Failure alerting (Gmail API via service account) ─────────────────────────
GMAIL_SEND_AS=alerts@example.org
ALERT_EMAIL=

# ── Backup sidecar retention ─────────────────────────────────────────────────
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

TZ=America/Chicago
